# ========================================================
# CCMP ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual values
# ========================================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 1. DATABASE & AUTHENTICATION (Supabase or Neon)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=replace_with_a_long_random_secret_key_32_chars_min

# 2. PAYMENT GATEWAY (Razorpay or Stripe)
# Razorpay:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# OR Stripe:
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# 3. TRANSACTIONAL EMAILS (Resend)
RESEND_API_KEY=
EMAIL_FROM="Campus Admin <onboarding@resend.dev>"

# 4. IN-MEMORY CACHE & RATE LIMITING (Upstash Redis - Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
